# Rust API config — copy to drtouhidtapan_api/.env on the server and fill in.

# Listen on localhost only; Apache proxies the public subdomain to this port.
HOST=127.0.0.1
PORT=3001
RUST_LOG=info

# cPanel MySQL — create the DB + user in cPanel first. Names are usually
# prefixed with your cPanel user, e.g. cpuser_drtapan / cpuser_dbuser.
DATABASE_URL=mysql://CPUSER_dbuser:DB_PASSWORD@localhost:3306/CPUSER_drtapan
DATABASE_MAX_CONNECTIONS=5

# Public origins allowed to call the API (the site that runs in the browser).
ALLOWED_ORIGINS=https://drtaponckdu.com,https://www.drtaponckdu.com

# Auth — use a long random string.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRY_HOURS=24

# Email (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dr. Tapan Chamber

# SMS (optional)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=DrTapan
SMS_ENABLED=false
