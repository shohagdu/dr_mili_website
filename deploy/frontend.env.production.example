# Frontend build/runtime config. Copy to  frontend/.env  before running
# deploy/build-and-package.sh (NEXT_PUBLIC_* values are baked in at build time).

# Root-domain deploy (https://drtaponckdu.com) — leave the base path EMPTY.
# Only set this if you serve under a subfolder, and match the cPanel Node App
# "Application URL" path exactly. Rebuild after any change (baked at build time).
NEXT_PUBLIC_BASE_PATH=

# Public URL of the Rust API (the subdomain that proxies to the binary).
# Must be HTTPS to avoid mixed-content blocking. Include the /api/v1 suffix.
NEXT_PUBLIC_API_URL=https://api.drtaponckdu.com/api/v1

# Canonical public site URL (used for SEO / metadata / sitemaps).
NEXT_PUBLIC_SITE_URL=https://drtaponckdu.com
