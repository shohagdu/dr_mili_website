# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,drtapan_api=debug

# ============================================================
# Database
# ============================================================
DATABASE_URL=mysql://drtapan_app:password@localhost:3306/drtapan
DATABASE_MAX_CONNECTIONS=10

# ============================================================
# CORS — comma-separated list of allowed origins
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,https://drtapan.com,https://www.drtapan.com

# ============================================================
# Auth (JWT)
# ============================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-bytes
JWT_EXPIRY_HOURS=24

# ============================================================
# Email (SMTP — for appointment confirmations)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@drtapan.com
SMTP_PASSWORD=app-password-here
SMTP_FROM_EMAIL=noreply@drtapan.com
SMTP_FROM_NAME=Dr. Tapan Chamber

# ============================================================
# SMS — BulkSMSBD (or any Bangladeshi SMS gateway)
# ============================================================
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=your-api-key-here
SMS_SENDER_ID=DrTapan
SMS_ENABLED=false   # set true in production
