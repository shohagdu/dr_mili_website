# LOCAL DEV overrides. To activate: `mv .env.local.devbak .env.local`
# (.env.local outranks .env, so it wins for local runs). Rename it BACK to
# .env.local.devbak before building for production, or these localhost URLs
# get baked into the production bundle and break the live site.

# No subfolder locally — serve the app at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Local Rust API (cargo run --bin drtapan-api listens on :8080).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Local site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics
NEXT_PUBLIC_GA_ID=
